# Nginx config for Render single-container deploy:
# serves Vite SPA + reverse-proxies API/Swagger to Spring Boot on 127.0.0.1:8080.
# Render injects $PORT (public). Only $PORT and $BACKEND_PORT are substituted
# at container start (see Dockerfile CMD) so $uri/$host tokens survive intact.
user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /tmp/nginx.pid;

events {
  worker_connections 1024;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  access_log /var/log/nginx/access.log;
  sendfile on;
  keepalive_timeout 65;
  gzip on;
  gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;

  server {
    listen ${PORT} default_server;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # --- API + docs go to Spring Boot (internal port, not Render's $PORT) ---
    location /api/ {
      proxy_pass http://127.0.0.1:${BACKEND_PORT};
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_read_timeout 60s;
    }

    location = /v3/api-docs {
      proxy_pass http://127.0.0.1:${BACKEND_PORT};
      proxy_set_header Host $host;
    }

    location /v3/api-docs/ {
      proxy_pass http://127.0.0.1:${BACKEND_PORT};
      proxy_set_header Host $host;
    }

    location /swagger-ui {
      proxy_pass http://127.0.0.1:${BACKEND_PORT};
      proxy_set_header Host $host;
    }

    location /swagger-ui/ {
      proxy_pass http://127.0.0.1:${BACKEND_PORT};
      proxy_set_header Host $host;
    }

    # --- SPA: static assets cached, everything else falls back to index.html ---
    location /assets/ {
      expires 1y;
      add_header Cache-Control "public, immutable";
      try_files $uri =404;
    }

    location / {
      try_files $uri $uri/ /index.html;
    }
  }
}
